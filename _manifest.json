{
  "manifest_version": 2,
  "id": "local.whale-speakup",
  "version": "0.1.1",
  "name": "主动搭话 · 麦麦适配版",
  "description": "在授权的私聊和群聊中本地抽签，满足时机后由麦麦自行决定是否主动开口。",
  "author": {
    "name": "idonotl",
    "url": "https://github.com/idonotl"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/idonotl/maibot-whale-speakup",
    "homepage": "https://github.com/idonotl/maibot-whale-speakup",
    "documentation": "https://github.com/idonotl/maibot-whale-speakup/blob/main/README.md",
    "issues": "https://github.com/idonotl/maibot-whale-speakup/issues"
  },
  "host_application": {
    "min_version": "1.3.15",
    "max_version": "1.3.19"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "plugin_type": "automation",
  "dependencies": [],
  "capabilities": [
    "chat.get_stream_by_user_id",
    "chat.get_stream_by_group_id",
    "chat.open_session",
    "chat.get_all_streams",
    "message.get_by_time_in_chat",
    "api.call",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
