{
  "schema_version": 2,
  "required_capabilities": ["declarative_basic"],
  "workspace_title": "主动搭话 · 麦麦适配版",
  "pages": [{
    "id": "overview", "title": "主动搭话状态", "placement": "workspace", "icon": "puzzle", "mode": "declarative",
    "description": "本地抽签；提交主动任务不代表实际发出消息，是否发言由麦麦决定。",
    "poll_interval_seconds": 0,
    "queries": {"runtime": {"api": "status", "version": "1"}, "targets": {"api": "inspect_targets", "version": "1"}},
    "actions": {"probe": {"api": "probe_isolated_webui", "version": "1", "parameters": {"user_id": {"type": "string", "required": true}}}},
    "content": [
      {"type": "grid", "label": "运行状态", "columns": 4, "children": [
        {"type": "stat", "label": "已就绪", "value": {"scope": "query", "source": "runtime", "field": "ready"}},
        {"type": "stat", "label": "试运行", "value": {"scope": "query", "source": "runtime", "field": "dry_run"}},
        {"type": "stat", "label": "已提交任务", "value": {"scope": "query", "source": "runtime", "field": "stats.queued"}},
        {"type": "stat", "label": "异常次数", "value": {"scope": "query", "source": "runtime", "field": "stats.failures"}}
      ]},
      {"type": "table", "label": "最近抽签与任务记录", "value": {"scope": "query", "source": "runtime", "field": "decisions"}, "columns": [
        {"field": "target", "label": "会话"}, {"field": "outcome", "label": "结果"}, {"field": "detail", "label": "说明"}, {"field": "at", "label": "时间戳"}
      ]},
      {"type": "table", "label": "授权会话", "value": {"scope": "query", "source": "targets", "field": "targets"}, "columns": [
        {"field": "target", "label": "会话"}, {"field": "eligibility", "label": "当前等待原因"}, {"field": "last_outcome", "label": "最近任务状态"}, {"field": "error", "label": "检查错误"}
      ]}
    ]
  }]
}
